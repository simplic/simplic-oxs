<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Simplic.OxS.Server\Simplic.OxS.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures/parcel-openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- What a service gets from the package: a project reference does not import a package's build targets. -->
  <Import Project="..\Simplic.OxS.Server\build\Simplic.OxS.Server.targets" />

  <!--
    The package holds the query engine's comments and its own beside its targets; the source
    tree does not, so this project names the files the package is packed with: the one beside
    the engine's assembly, and the one the server project's build wrote. The project reference
    lists the second for the output too, as a package reference with documentation files
    would: the targets put theirs in its place, which the publish test holds them to.
  -->
  <Target Name="NameTheQueryApiCommentsThePackageIsPackedWith"
          BeforeTargets="SimplicOxSFindQueryApiComments"
          DependsOnTargets="ResolvePackageAssets">
    <ItemGroup>
      <_QueryApiAssembly Include="@(ResolvedCompileFileDefinitions)" Condition="'%(ResolvedCompileFileDefinitions.Filename)%(ResolvedCompileFileDefinitions.Extension)' == 'OxQL.AspNetCore.dll'" />
    </ItemGroup>
    <PropertyGroup>
      <_SimplicOxSQueryApiCommentsFile>@(_QueryApiAssembly->'%(RootDir)%(Directory)%(Filename).xml')</_SimplicOxSQueryApiCommentsFile>
      <_SimplicOxSPackageCommentsFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', 'Simplic.OxS.Server', 'bin', '$(Configuration)', '$(TargetFramework)', 'Simplic.OxS.Server.xml'))</_SimplicOxSPackageCommentsFile>
    </PropertyGroup>
  </Target>

</Project>
