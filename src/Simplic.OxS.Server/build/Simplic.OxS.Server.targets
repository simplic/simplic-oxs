<Project>

  <!--
    Puts the XML comments of the query engine's HTTP assembly beside the assemblies of a project
    that references this package, in its build output and in what it publishes. The OpenAPI
    document of a service takes the descriptions of the OxQL routes' parameters and of the members
    of their bodies from that file (SwaggerExtension includes every OxQL.*.xml it finds there).

    The file is the one packed beside these targets, taken from the engine version the package
    was built against. It is in every restored package, also where the restore leaves
    documentation files out (NUGET_XMLDOC_MODE=skip, the setting of the .NET SDK container
    images), and it is the only source: a build on a developer's machine and one in a container
    give the same document. Where a project also lists a file of that name for its output
    (CopyDocumentationFilesFromPackages, PublishReferencesDocumentationFiles), this one takes its
    place, so the output holds one.

    Only that one file is copied. A project that wants none sets SimplicOxSCopyQueryApiComments
    to false; its document then carries the routes without those sentences.
  -->
  <PropertyGroup>
    <!-- A project that imports these targets from the source tree names the file itself. -->
    <_SimplicOxSQueryApiCommentsFile Condition="'$(_SimplicOxSQueryApiCommentsFile)' == ''">$(MSBuildThisFileDirectory)OxQL.AspNetCore.xml</_SimplicOxSQueryApiCommentsFile>
  </PropertyGroup>

  <Target Name="SimplicOxSFindQueryApiComments"
          Condition="'$(SimplicOxSCopyQueryApiComments)' != 'false'">
    <ItemGroup>
      <SimplicOxSQueryApiComments Include="$(_SimplicOxSQueryApiCommentsFile)"
                                  Condition="Exists('$(_SimplicOxSQueryApiCommentsFile)')"
                                  Exclude="@(SimplicOxSQueryApiComments)" />
    </ItemGroup>
  </Target>

  <Target Name="SimplicOxSCopyQueryApiComments"
          AfterTargets="ResolveAssemblyReferences"
          DependsOnTargets="SimplicOxSFindQueryApiComments"
          Condition="'$(SimplicOxSCopyQueryApiComments)' != 'false'">
    <ItemGroup Condition="'@(SimplicOxSQueryApiComments)' != ''">
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.DestinationSubDirectory)%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'OxQL.AspNetCore.xml'" />
      <ReferenceCopyLocalPaths Include="@(SimplicOxSQueryApiComments)" />
    </ItemGroup>
  </Target>

  <Target Name="SimplicOxSPublishQueryApiComments"
          AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="SimplicOxSFindQueryApiComments"
          Condition="'$(SimplicOxSCopyQueryApiComments)' != 'false'">
    <ItemGroup Condition="'@(SimplicOxSQueryApiComments)' != ''">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'OxQL.AspNetCore.xml'" />
      <ResolvedFileToPublish Include="@(SimplicOxSQueryApiComments)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
